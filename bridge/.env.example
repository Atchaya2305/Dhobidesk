# Bridge Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173

# HiveMQ Cloud MQTT Broker
HIVEMQ_URL=mqtts://your-cluster-id.s1.eu.hivemq.cloud:8883
HIVEMQ_USERNAME=your-mqtt-username
HIVEMQ_PASSWORD=your-mqtt-password

# Firebase Service Account Credentials
# Path to serviceAccountKey.json (relative to /bridge or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Alternatively, the raw JSON string of the service account key (useful in production/CI environments):
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
